{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Nuxt I18n Micro",
  "colors": {
    "primary": "#00DC82",
    "light": "#00DC82",
    "dark": "#003C3C"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "installation"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/configuration",
              "guides/using-translations",
              "guides/routing-strategies",
              "guides/per-component-translations",
              "guides/custom-locale-routes",
              "guides/seo",
              "guides/custom-language-detection",
              "guides/server-side-translations",
              "guides/performance",
              "guides/layers",
              "guides/multi-domain-locales",
              "guides/runtime-overrides",
              "guides/faq"
            ]
          },
          {
            "group": "Migration",
            "pages": [
              "migration/from-nuxtjs-i18n",
              "migration/v2-to-v3"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "examples"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "api/overview",
              "api/module-options",
              "api/methods",
              "api/events",
              "api/cache"
            ]
          },
          {
            "group": "Composables",
            "pages": [
              "api/composables/use-i18n",
              "api/composables/use-i18n-locale",
              "api/composables/use-locale-head",
              "api/composables/use-i18n-head"
            ]
          },
          {
            "group": "Components",
            "pages": [
              "api/components/i18n-t",
              "api/components/i18n-link",
              "api/components/i18n-switcher",
              "api/components/i18n-group"
            ]
          }
        ]
      },
      {
        "tab": "Integrations",
        "groups": [
          {
            "group": "Framework integrations",
            "pages": [
              "integrations/overview",
              "integrations/vue",
              "integrations/react",
              "integrations/preact",
              "integrations/solid",
              "integrations/astro",
              "integrations/nodejs"
            ]
          },
          {
            "group": "Tooling",
            "pages": [
              "integrations/types-generator",
              "integrations/devtools-ui"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/s00d/nuxt-i18n-micro",
          "icon": "github"
        },
        {
          "anchor": "npm",
          "href": "https://www.npmjs.com/package/nuxt-i18n-micro",
          "icon": "npm"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/s00d/nuxt-i18n-micro"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/s00d/nuxt-i18n-micro"
    }
  }
}
